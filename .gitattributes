# cmd.exe misreads labels and gotos in batch files with LF line endings
*.bat text eol=crlf

# Linux scripts and config read by Docker/shell must keep LF, even when the repo is checked out on Windows
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Append-only agent journal: parallel branches add entries at the end without rebase conflicts
OPTIMIZE-TODO.md merge=union
