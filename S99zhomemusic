#!/bin/sh
# Start the HomeMusic native bridge after Quasar/Alice on a rooted Station Lite.
# Every daemon takes its own lock directory, so repeated starts are harmless.
DIR=/data/opt/homemusic

matching() {
    sig=$1
    # Never signal this script or any of its parents: an inline SSH command
    # often contains the same paths and would kill its own shell.
    anc=" $$ "
    q=$$
    while [ "$q" != "1" ]; do
        q=$(awk '{print $4}' "/proc/$q/stat" 2>/dev/null)
        [ -n "$q" ] || break
        anc="$anc$q "
    done
    for d in /proc/[0-9]*; do
        p=${d#/proc/}
        case "$anc" in *" $p "*) continue ;; esac
        [ -r "$d/cmdline" ] || continue
        c=$(cat "$d/cmdline" 2>/dev/null | tr '\0' ' ')
        # Skip shell wrappers that carry a whole multi-line script: their
        # cmdline contains the paths below and they would kill themselves.
        case "$c" in *"
"*) continue ;; esac
        case "$c" in
            *"$DIR/voice-bridge.sh"*|*"$DIR/alice-text.sh"*|*"$DIR/mediad-guard.sh"*|*"$DIR/command-watch.sh"*|*"$DIR/hm-play.sh"*|*"$DIR/hm-api.sh"*|*"$DIR/hm-api-daemon.sh"*|*"socat TCP-LISTEN:8099"*|*"socat -x -u TCP:127.0.0.1:9875"*|*"alice-text.awk"*)
                kill -$sig "$p" 2>/dev/null ;;
        esac
    done
}

case "$1" in
    start)
        [ -x "$DIR/voice-bridge.sh" ] || exit 0
        # /tmp is tmpfs, so this marker only survives within one boot. After a
        # reboot every lock and player state is stale and must be dropped.
        if [ ! -f /tmp/homemusic.booted ]; then
            rm -rf "$DIR"/*.lock "$DIR/native.pid" "$DIR/player.pid" "$DIR/guard.pid" \
                   "$DIR/paused" "$DIR/pos" "$DIR/started" "$DIR/index" \
                   "$DIR/seek" "$DIR/duck" "$DIR/level" "$DIR/jump" "$DIR/cmdseq" "$DIR/api.pid"
            [ -x "$DIR/music-block.sh" ] && "$DIR/music-block.sh" off >>"$DIR/music-block.log" 2>&1
            : > /tmp/homemusic.booted
        fi
        [ -x "$DIR/mediad-guard.sh" ] &&
            ( cd "$DIR" && setsid "$DIR/mediad-guard.sh" >>"$DIR/mediad-guard.log" 2>&1 </dev/null & )
        [ -x "$DIR/hm-api-daemon.sh" ] &&
            ( cd "$DIR" && setsid "$DIR/hm-api-daemon.sh" >>"$DIR/api.log" 2>&1 </dev/null & )
        [ -x "$DIR/command-watch.sh" ] &&
            ( cd "$DIR" && setsid "$DIR/command-watch.sh" >>"$DIR/command-watch.log" 2>&1 </dev/null & )
        ( cd "$DIR" && setsid "$DIR/voice-bridge.sh" >>"$DIR/voice.log" 2>&1 </dev/null & )
        ;;
    stop)
        matching TERM
        sleep 2
        matching KILL
        # End the native session on the station, but keep mediad (Alice and the
        # native player live there) running.
        [ -x "$DIR/hm-play.sh" ] && "$DIR/hm-play.sh" stop >/dev/null 2>&1
        [ -x "$DIR/music-block.sh" ] && "$DIR/music-block.sh" off >>"$DIR/music-block.log" 2>&1
        rm -rf "$DIR/bridge.pid" "$DIR/mediad-guard.pid" "$DIR/command-watch.pid" \
               "$DIR/api.pid" \
               "$DIR/voice-bridge.lock" "$DIR/mediad-guard.lock" "$DIR/command-watch.lock" "$DIR/command-watch.fifo" \
               "$DIR/native.pid" "$DIR/paused" "$DIR/index"
        ;;
    restart)
        "$0" stop; sleep 1; "$0" start ;;
esac
exit 0
