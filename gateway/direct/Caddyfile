# The Hub straight from this computer, for a home with a public (static) IP address: no VPS, no tunnel.
# The router forwards ports 80 and 443 here; the domain's A record points at the home's address; Caddy gets the
# certificate from Let's Encrypt by itself and renews it. Navidrome is not published: the Hub is all the app needs.
{$PUBLIC_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	# Navidrome's own API (Subsonic, for other players and the Android app) is not let in from outside: it takes a
	# password in every request and counts no wrong ones. The web app does not use it. To open it, remove this.
	@subsonic path /rest /rest/*
	respond @subsonic 404
	# SSE (/api/events) is flushed immediately; uploads up to 500 MB are streamed without a body limit.
	reverse_proxy hub:8080 {
		flush_interval -1
	}
}
