# The Hub and Navidrome over HTTPS in the home network: no VPS, no public 80/443.
# The Hub keeps 8080 on the LAN (the router's 8445 leads here), Navidrome keeps 4533 (8444 leads here).
{
	admin off
	auto_https disable_redirects
	# A browser has no SNI when it opens https://<ip>: the LAN certificate still has the IP in its SAN.
	default_sni {$HUB_NAME}
	# Only TCP ports are published: HTTP/3 on 443 would be advertised but unreachable.
	servers {
		protocols h1 h2
	}
}

(headers) {
	encode zstd gzip
	# No HSTS: the same host still has plain-HTTP clients on other ports.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
}

(hub) {
	# The local CA for LAN addresses, downloadable from the trusted public address too.
	handle /ca.crt {
		root * /etc/caddy/certs
		file_server
	}
	# SSE (/api/events) is flushed at once; uploads are streamed without a body limit.
	handle {
		reverse_proxy hub:8080 {
			flush_interval -1
		}
	}
}

(navidrome) {
	reverse_proxy navidrome:4533 {
		flush_interval -1
	}
}

# The Hub: 8080 on the LAN, the router's 8445 outside (both arrive on this listener).
https://{$PUBLIC_HOST}:8080 {
	tls /etc/caddy/certs/le.crt /etc/caddy/certs/le.key
	import headers
	import hub
}
https://{$HUB_IP}:8080, https://{$HUB_NAME}:8080 {
	tls /etc/caddy/certs/homemusic.crt /etc/caddy/certs/homemusic.key
	import headers
	import hub
}

# Navidrome: 4533 on the LAN, the router's 8444 outside (both arrive on this listener).
https://{$PUBLIC_HOST}:4533 {
	tls /etc/caddy/certs/le.crt /etc/caddy/certs/le.key
	import headers
	import navidrome
}
https://{$HUB_IP}:4533, https://{$HUB_NAME}:4533 {
	tls /etc/caddy/certs/homemusic.crt /etc/caddy/certs/homemusic.key
	import headers
	import navidrome
}
