# The Hub over HTTPS in the home network: no VPS, no public 80/443.
# One certificate for the public name (Let's Encrypt, from the router) and one local CA for LAN addresses.
# A device that opens the public name needs nothing installed; a LAN IP needs the local CA:
#   http://<this host>/ca.crt
{
	admin off
	auto_https disable_redirects
	# A browser has no SNI when it opens https://<ip>: the LAN certificate still has the IP in its SAN.
	default_sni {$HUB_NAME}
}

(common) {
	encode zstd gzip
	# No HSTS: the same host still serves Navidrome over plain HTTP on 8444, and HSTS would upgrade it to a dead port.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	# SSE (/api/events) is flushed at once; uploads are streamed without a body limit.
	reverse_proxy hub:8080 {
		flush_interval -1
	}
}

# The router's Let's Encrypt certificate for the public DDNS name.
https://{$PUBLIC_HOST} {
	tls /etc/caddy/certs/le.crt /etc/caddy/certs/le.key
	import common
}

# LAN by IP or name: the local CA, so the Hub is reachable even when the router is offline.
https://{$HUB_IP}, https://{$HUB_NAME} {
	tls /etc/caddy/certs/homemusic.crt /etc/caddy/certs/homemusic.key
	import common
}

# The CA certificate is the only thing plain HTTP still serves, then everything else goes to HTTPS.
http://{$HUB_IP}, http://{$HUB_NAME} {
	handle /ca.crt {
		root * /etc/caddy/certs
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}
